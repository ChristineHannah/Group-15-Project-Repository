# Build directory generated by CMake
build/
build_new/

# Compiled object files and executables
*.o // means ignore object files
*.obj //means ignore windows object files
*.exe //means ignore executable files
*.out // means ignore compiled output files

# IDE and OS specific hidden files
.vscode/
.idea/
.DS_Store
Thumbs.db

#This file prevents binary clutter in the GitHub shared repository by ignoring compiled object files, executables, and IDE-specific files that are not relevant to the source code. It ensures that only the source code and necessary configuration files are tracked in version control.